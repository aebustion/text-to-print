# Copy this file to .env and fill in your own values:
#   cp .env.example .env
#
# .env is gitignored and must never be committed. Keep machine-specific and
# secret values here so config.json stays safe to commit.

# Beeper Desktop API token.
# Create one in Beeper Desktop: Settings -> Integrations -> "+" next to
# "Approved connections". Tokens expire; if printing stops with an
# "expired or invalid" message, create a new one and replace this value.
BEEPER_ACCESS_TOKEN=your_token_here

# Optional: pin the printer's BLE address for this machine.
# macOS assigns each Mac its OWN address for the same printer, so this value is
# not portable -- that's why it lives here instead of config.json.
# Get it by running:  python3 text_printer.py --scan
# Leave unset to auto-discover the printer by name.
# PRINTER_ADDRESS=
